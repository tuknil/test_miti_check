# Example environment for docker-compose. Copy to `.env` and fill in.
# Docker Compose auto-loads `.env` and substitutes ${VAR} in docker-compose.yml.
# Every value is optional — unset vars fall back to the code defaults (the local
# `db` Postgres container via the DATABASE_URL baked into docker-compose.yml).
# Do NOT commit a real `.env` (it is gitignored).

# ── Ledger DB selector ────────────────────────────────────────────────
# POSTGRES_ENV=PROD (the code default) connects to Azure Database for PostgreSQL
# via a User-Assigned Managed Identity (UMI) using the PG_* vars below.
# POSTGRES_ENV=DEV uses the DATABASE_URL client (and the entra path below).
# docker-compose defaults this to DEV so the bundled `db` container works.
POSTGRES_ENV=DEV

# ── PROD: Azure Database for PostgreSQL via User-Assigned Managed Identity ─
# Used when POSTGRES_ENV=PROD. The workload must run on Azure with the UMI
# attached; AZURE_CLIENT_ID (below) is the UMI's client ID.
PG_HOST=                    # <server>.postgres.database.azure.com
PG_DATABASE=
PG_USER=                    # UMI name registered as a Postgres AAD principal
PG_PORT=5432
PG_SSL_MODE=require

# ── DEV: Azure Database for PostgreSQL via Entra ID (service principal) ─
# DATABASE_AUTH_MODE=entra uses a Microsoft Entra ID token as the password
# (refreshed per connection) and IGNORES the compose DATABASE_URL. Leave unset for
# the local password path. Only consulted when POSTGRES_ENV=DEV.
DATABASE_AUTH_MODE=
DATABASE_HOST=              # <server>.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=              # the Entra principal (managed identity / app name)
DATABASE_SSL_MODE=verify-full
DATABASE_MIGRATION_MODE=    # set to "external" to skip in-app CREATE TABLE/migrations

# ── Azure credentials (service principal; also used by the aci-sp mode) ──
# When all three are set, they authenticate the Postgres token and aci-sp. If
# unset (e.g. running on Azure), the code falls back to a managed identity.
# AZURE_CLIENT_ID is ALSO the UMI client ID used by POSTGRES_ENV=PROD.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_POSTGRES_TOKEN_SCOPE=https://ossrdbms-aad.database.windows.net/.default

# ── Databricks result sink (optional; DSN carries a token) ───────────
DATABRICKS_DSN=             # token:<PAT>@<host>/sql/1.0/warehouses/<id>
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=
DATABRICKS_TABLE=

# ── Azure ACI execution mode (optional) ──────────────────────────────
AZURE_SUBSCRIPTION_ID=
MC_ACI_RESOURCE_GROUP=
MC_ACI_REGION=

# ── Private registry for the github-ghcr relay (optional) ────────────
JFROG_REGISTRY=
JFROG_USER=
JFROG_TOKEN=

# ── Completion callbacks (optional) ──────────────────────────────────
CAPABILITY_CALLBACK_TOKEN=
CAPABILITY_CALLBACK_ALLOWED_HOSTS=

# ── UI ───────────────────────────────────────────────────────────────
API_BASE=http://localhost:8137
